+namespace {
+std::vector<content::WeakDocumentPtr>& AuthorizedDocuments() {
+  static base::NoDestructor<std::vector<content::WeakDocumentPtr>> documents;
+  return *documents;
+}
+bool Authorized(content::RenderFrameHost* frame) {
+  auto& documents = AuthorizedDocuments();
+  std::erase_if(documents, [](const auto& document) {
+    return !document.AsRenderFrameHostIfValid();
+  });
+  for (const auto& document : documents) {
+    if (document.AsRenderFrameHostIfValid() == frame) {
+      return true;
+    }
+  }
+  return false;
+}
+}
+
+void JustCefRegisterSurfaceInterfaces(
+    content::RenderFrameHost* frame,
+    blink::AssociatedInterfaceRegistry& registry) {
+  registry.RemoveInterface(surface_embed::mojom::SurfaceEmbedHost::Name_);
+  registry.AddInterface<surface_embed::mojom::SurfaceEmbedHost>(
+      base::BindRepeating(
+          [](content::GlobalRenderFrameHostId id,
+             mojo::PendingAssociatedReceiver<
+                 surface_embed::mojom::SurfaceEmbedHost> receiver) {
+            auto* frame = content::RenderFrameHost::FromID(id);
+            if (frame && Authorized(frame)) {
+              surface_embed::SurfaceEmbedHost::Create(frame,
+                                                      std::move(receiver));
+            }
+          },
+          frame->GetGlobalId()));
+}
