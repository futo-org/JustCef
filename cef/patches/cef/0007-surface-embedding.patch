+extern "C" CEF_EXPORT int justcef_guest_surface_id(int guest_id,
+                                                   int host_id,
+                                                   char* output,
+                                                   size_t capacity) {
+  CEF_REQUIRE_UIT_RETURN(0);
+  if (guest_id <= 0 || host_id <= 0 || guest_id == host_id || !output) {
+    return 0;
+  }
+  auto guest = CefBrowserHostBase::GetBrowserForBrowserId(guest_id);
+  auto host = CefBrowserHostBase::GetBrowserForBrowserId(host_id);
+  if (!guest || !host || !guest->GetWebContents() || !host->GetWebContents()) {
+    return 0;
+  }
+  auto* document = host->GetWebContents()->GetPrimaryMainFrame();
+  const auto id = guest_contents::GuestContentsHandle::CreateForWebContents(
+                      guest->GetWebContents())
+                      ->id()
+                      .ToString();
+  if (capacity <= id.size()) {
+    return 0;
+  }
+  if (!Authorized(document)) {
+    AuthorizedDocuments().push_back(document->GetWeakDocumentPtr());
+  }
+  std::memcpy(output, id.c_str(), id.size() + 1);
+  return 1;
+}
+extern "C" CEF_EXPORT int justcef_guest_is_attached(int guest_id) {
+  CEF_REQUIRE_UIT_RETURN(0);
+  if (guest_id <= 0) {
+    return 0;
+  }
+  auto guest = CefBrowserHostBase::GetBrowserForBrowserId(guest_id);
+  return guest && guest->GetWebContents() &&
+         guest->GetWebContents()->GetSurfaceEmbedConnector();
+}
+extern "C" CEF_EXPORT void justcef_guest_detach(int guest_id) {
+  CEF_REQUIRE_UIT();
+  if (guest_id <= 0) {
+    return;
+  }
+  auto guest = CefBrowserHostBase::GetBrowserForBrowserId(guest_id);
+  if (guest && guest->GetWebContents() &&
+      guest->GetWebContents()->GetSurfaceEmbedConnector()) {
+    guest->GetWebContents()
+        ->GetSurfaceEmbedConnector()
+        ->GetDelegate()
+        ->DetachedByHost();
+  }
+}
+extern "C" CEF_EXPORT void justcef_guest_focus(int guest_id) {
+  CEF_REQUIRE_UIT();
+  if (guest_id <= 0) {
+    return;
+  }
+  auto guest = CefBrowserHostBase::GetBrowserForBrowserId(guest_id);
+  if (guest && guest->GetWebContents()) {
+    guest->GetWebContents()->Focus();
+  }
+}
+extern "C" CEF_EXPORT int justcef_guest_transform_rect(
+    int guest_id, int* x, int* y, int* width, int* height) {
+  CEF_REQUIRE_UIT_RETURN(0);
+  auto guest = CefBrowserHostBase::GetBrowserForBrowserId(guest_id);
+  if (!guest || !guest->GetWebContents() || !x || !y || !width || !height ||
+      !guest->GetWebContents()->GetSurfaceEmbedConnector()) return 0;
+  auto* view = guest->GetWebContents()->GetRenderWidgetHostView();
+  if (!view) return 0;
+  const float zoom = std::pow(1.2, guest->GetZoomLevel());
+  gfx::PointF corners[] = {
+      gfx::PointF(*x * zoom, *y * zoom),
+      gfx::PointF((*x + *width) * zoom, *y * zoom),
+      gfx::PointF(*x * zoom, (*y + *height) * zoom),
+      gfx::PointF((*x + *width) * zoom, (*y + *height) * zoom)};
+  float left = INFINITY, top = INFINITY, right = -INFINITY, bottom = -INFINITY;
+  for (const auto& corner : corners) {
+    auto point = view->TransformPointToRootCoordSpaceF(corner);
+    left = std::min(left, point.x()); top = std::min(top, point.y());
+    right = std::max(right, point.x()); bottom = std::max(bottom, point.y());
+  }
+  *x = std::floor(left); *y = std::floor(top);
+  *width = std::ceil(right) - *x; *height = std::ceil(bottom) - *y;
+  return 1;
+}
