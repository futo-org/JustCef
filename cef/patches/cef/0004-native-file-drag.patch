+bool ChromeContentBrowserClientCef::OverrideDragFilePaths(
+    content::RenderFrameHost& source_frame,
+    std::vector<base::FilePath>* file_paths) {
+  CEF_REQUIRE_UIT();
+
+  auto browser = CefBrowserHostBase::GetBrowserForContents(
+      content::WebContents::FromRenderFrameHost(&source_frame));
+  if (!browser || browser->IsWindowless()) {
+    return false;
+  }
+  auto client = browser->GetClient();
+  auto handler = client ? client->GetDragHandler() : nullptr;
+  auto frame = browser->GetFrameForHost(&source_frame);
+  if (!handler || !frame) {
+    return false;
+  }
+
+  std::vector<CefString> paths;
+  if (!handler->OnBeforeFileDrag(browser.get(), frame, paths)) {
+    return false;
+  }
+  for (const auto& path : paths) {
+    if (path.ToString16().find(u'\0') != std::u16string::npos) {
+      file_paths->clear();
+      return true;
+    }
+    file_paths->emplace_back(path);
+  }
+  return true;
+}
