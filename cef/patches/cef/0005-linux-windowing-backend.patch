+namespace {
+
+void LinuxWindowingBackendImpl() {
+  const auto backend = CefGetLinuxWindowingBackend();
+#if defined(OS_LINUX)
+  EXPECT_GE(backend, CEF_LINUX_WINDOWING_BACKEND_UNKNOWN);
+  EXPECT_LE(backend, CEF_LINUX_WINDOWING_BACKEND_WAYLAND);
+  const auto requested = CefCommandLine::GetGlobalCommandLine()
+                             ->GetSwitchValue("ozone-platform")
+                             .ToString();
+  if (requested == "x11") {
+    EXPECT_EQ(CEF_LINUX_WINDOWING_BACKEND_X11, backend);
+  } else if (requested == "wayland") {
+    EXPECT_EQ(CEF_LINUX_WINDOWING_BACKEND_WAYLAND, backend);
+  } else if (requested == "headless") {
+    EXPECT_EQ(CEF_LINUX_WINDOWING_BACKEND_UNKNOWN, backend);
+  }
+#else
+  EXPECT_EQ(CEF_LINUX_WINDOWING_BACKEND_UNKNOWN, backend);
+#endif
+}
