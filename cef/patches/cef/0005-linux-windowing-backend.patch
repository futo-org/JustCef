+cef_linux_windowing_backend_t CefGetLinuxWindowingBackend() {
+  CEF_REQUIRE_UIT_RETURN(CEF_LINUX_WINDOWING_BACKEND_UNKNOWN);
+#if BUILDFLAG(IS_LINUX)
+  if (auto* delegate = ui::LinuxUiDelegate::GetInstance()) {
+    switch (delegate->GetBackend()) {
+      case ui::LinuxUiBackend::kX11:
+        return CEF_LINUX_WINDOWING_BACKEND_X11;
+      case ui::LinuxUiBackend::kWayland:
+        return CEF_LINUX_WINDOWING_BACKEND_WAYLAND;
+      case ui::LinuxUiBackend::kStub:
+        break;
+    }
+  }
+#endif
+  return CEF_LINUX_WINDOWING_BACKEND_UNKNOWN;
+}
