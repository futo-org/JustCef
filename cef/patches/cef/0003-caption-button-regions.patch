+#if defined(OS_WIN)
+class CaptionButtonPressDelegate : public CefButtonDelegate {
+ public:
+  void OnButtonPressed(CefRefPtr<CefButton> button) override { ++presses; }
+  int presses = 0;
+
+ private:
+  IMPLEMENT_REFCOUNTING(CaptionButtonPressDelegate);
+};
+#endif
+
+void RunWindowCaptionButtonRegions(CefRefPtr<CefWindow> window) {
+  const CefRect minimize(0, 0, 60, 40);
+  const CefRect maximize(60, 0, 60, 40);
+  const CefRect close(120, 0, 60, 40);
+#if defined(OS_WIN)
+  window->Show();
+  window->Layout();
+  EXPECT_TRUE(window->SetCaptionButtonRegions(minimize, maximize, close));
+  const auto hwnd = window->GetWindowHandle();
+  const auto hit_test = [hwnd](int x, int y) {
+    const int dpi = GetDpiForWindow(hwnd);
+    POINT point{MulDiv(x, dpi, 96), MulDiv(y, dpi, 96)};
+    ClientToScreen(hwnd, &point);
+    return SendMessage(hwnd, WM_NCHITTEST, 0, MAKELPARAM(point.x, point.y));
+  };
+  std::vector<CefDraggableRegion> drag(1);
+  drag[0].bounds = CefRect(0, 0, 240, 40);
+  drag[0].draggable = true;
+  window->SetDraggableRegions(drag);
+  EXPECT_EQ(HTMINBUTTON, hit_test(30, 20));
+  EXPECT_EQ(HTMAXBUTTON, hit_test(90, 20));
+  EXPECT_EQ(HTCLOSE, hit_test(150, 20));
+  EXPECT_EQ(HTCAPTION, hit_test(210, 20));
+  EXPECT_EQ(HTTOPLEFT, hit_test(1, 1));
+  EXPECT_FALSE(window->SetCaptionButtonRegions(minimize, minimize, close));
+  EXPECT_FALSE(
+      window->SetCaptionButtonRegions(CefRect(0, 0, -1, 20), maximize, close));
+  EXPECT_FALSE(window->SetCaptionButtonRegions(CefRect(INT32_MAX, 0, 1, 20),
+                                               maximize, close));
+  EXPECT_EQ(HTMAXBUTTON, hit_test(90, 20));
+  CefRefPtr<CaptionButtonPressDelegate> pressed =
+      new CaptionButtonPressDelegate;
+  auto button = CefLabelButton::CreateLabelButton(pressed, "Maximize");
+  window->AddChildView(button);
+  button->SetBounds(maximize);
+  POINT client_point{MulDiv(90, GetDpiForWindow(hwnd), 96),
+                     MulDiv(20, GetDpiForWindow(hwnd), 96)};
+  POINT screen_point = client_point;
+  ClientToScreen(hwnd, &screen_point);
+  const auto screen_coords = MAKELPARAM(screen_point.x, screen_point.y);
+  SendMessage(hwnd, WM_NCMOUSEMOVE, HTMAXBUTTON, screen_coords);
+  EXPECT_EQ(CEF_BUTTON_STATE_HOVERED, button->GetState());
+  SendMessage(hwnd, WM_NCLBUTTONDOWN, HTMAXBUTTON, screen_coords);
+  SendMessage(hwnd, WM_LBUTTONUP, 0,
+              MAKELPARAM(client_point.x, client_point.y));
+  EXPECT_EQ(1, pressed->presses);
+  SendMessage(hwnd, WM_NCLBUTTONDOWN, HTMAXBUTTON, screen_coords);
+  const auto outside_coords =
+      MAKELPARAM(MulDiv(210, GetDpiForWindow(hwnd), 96), client_point.y);
+  SendMessage(hwnd, WM_MOUSEMOVE, MK_LBUTTON, outside_coords);
+  SendMessage(hwnd, WM_LBUTTONUP, 0, outside_coords);
+  EXPECT_EQ(1, pressed->presses);
+  SendMessage(hwnd, WM_NCMOUSEMOVE, HTMAXBUTTON, screen_coords);
+  EXPECT_EQ(CEF_BUTTON_STATE_HOVERED, button->GetState());
+  window->RemoveChildView(button);
+  EXPECT_TRUE(window->SetCaptionButtonRegions(CefRect(), CefRect(), CefRect()));
+  EXPECT_EQ(HTCAPTION, hit_test(90, 20));
+#else
+  EXPECT_FALSE(window->SetCaptionButtonRegions(minimize, maximize, close));
+#endif
+}
+
+void WindowCaptionButtonRegionsImpl(CefRefPtr<CefWaitableEvent> event) {
+  auto config = std::make_unique<TestWindowDelegate::Config>();
+  config->frameless = true;
+  config->on_window_created = base::BindOnce(RunWindowCaptionButtonRegions);
+  TestWindowDelegate::RunTest(event, std::move(config));
+}
+
+void WindowCaptionButtonRegionsFramedImpl(CefRefPtr<CefWaitableEvent> event) {
+  auto config = std::make_unique<TestWindowDelegate::Config>();
+  config->on_window_created = base::BindOnce([](CefRefPtr<CefWindow> window) {
+    EXPECT_FALSE(window->SetCaptionButtonRegions(CefRect(20, 10, 40, 30),
+                                                 CefRect(), CefRect()));
+  });
+  TestWindowDelegate::RunTest(event, std::move(config));
+}
