+#if BUILDFLAG(IS_WIN)
+class CefWindowView::CaptionButtonEventHandler : public ui::EventHandler,
+                                                 public aura::WindowObserver {
+ public:
+  CaptionButtonEventHandler(CefWindowView* view, aura::Window* window)
+      : view_(view), window_(window) {
+    window_->AddObserver(this);
+    window_->AddPreTargetHandler(this);
+  }
+
+  ~CaptionButtonEventHandler() override {
+    if (window_) {
+      window_->RemovePreTargetHandler(this);
+      window_->RemoveObserver(this);
+    }
+  }
+
+  void OnWindowDestroying(aura::Window* window) override {
+    window_->RemovePreTargetHandler(this);
+    window_->RemoveObserver(this);
+    window_ = nullptr;
+  }
+
+  void OnMouseEvent(ui::MouseEvent* event) override {
+    if (!window_ || !(event->flags() & ui::EF_IS_NON_CLIENT)) {
+      return;
+    }
+    gfx::Point point = event->root_location();
+    aura::Window::ConvertPointToTarget(window_->GetRootWindow(), window_,
+                                       &point);
+    auto* frame = view_->GetFrameView();
+    if (!frame) {
+      return;
+    }
+    const int component = frame->NonClientHitTest(point);
+    if (component != HTMINBUTTON && component != HTMAXBUTTON &&
+        component != HTCLOSE) {
+      return;
+    }
+    if (!event->HasNativeEvent()) {
+      event->SetFlags(event->flags() & ~ui::EF_IS_NON_CLIENT);
+      return;
+    }
+    ui::MouseEvent client_event(event->type(), event->root_location_f(),
+                                event->root_location_f(), event->time_stamp(),
+                                event->flags() & ~ui::EF_IS_NON_CLIENT,
+                                event->changed_button_flags());
+    auto* host = window_->GetHost();
+    client_event.UpdateForRootTransform(
+        host->GetRootTransform(),
+        host->GetRootTransformForLocalEventCoordinates());
+    auto* sink = host->GetEventSink();
+    const auto native_event = event->native_event();
+    const bool native_hover = event->type() == ui::EventType::kMouseMoved &&
+                              native_event.message == WM_NCMOUSEMOVE;
+    const auto weak_view = view_->weak_ptr_factory_.GetWeakPtr();
+    const auto weak_window = window_->GetWeakPtrAsWindow();
+    event->StopPropagation();
+    sink->OnEventFromSource(&client_event);
+    if (native_hover && weak_view && weak_window &&
+        views::HWNDForNativeWindow(weak_window.get()) == native_event.hwnd &&
+        ::IsWindow(native_event.hwnd)) {
+      ::DefWindowProc(native_event.hwnd, native_event.message,
+                      native_event.wParam, native_event.lParam);
+    }
+  }
+
+ private:
+  const raw_ptr<CefWindowView> view_;
+  raw_ptr<aura::Window> window_;
+};
+#endif
