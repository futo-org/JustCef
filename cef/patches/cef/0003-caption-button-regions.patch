+bool CefWindowView::SetCaptionButtonRegions(const CefRect& minimize,
+                                            const CefRect& maximize,
+                                            const CefRect& close) {
+#if BUILDFLAG(IS_WIN)
+  if (!is_frameless_ || !GetWidget()) {
+    return false;
+  }
+  const std::array<CefRect, 3> input{minimize, maximize, close};
+  std::array<gfx::Rect, 3> regions;
+  for (size_t i = 0; i < input.size(); ++i) {
+    const auto& rect = input[i];
+    if (rect.width == 0 && rect.height == 0) {
+      continue;
+    }
+    if (rect.width <= 0 || rect.height <= 0 ||
+        int64_t(rect.x) + rect.width > std::numeric_limits<int32_t>::max() ||
+        int64_t(rect.y) + rect.height > std::numeric_limits<int32_t>::max()) {
+      return false;
+    }
+    regions[i] = gfx::Rect(rect.x, rect.y, rect.width, rect.height);
+    for (size_t j = 0; j < i; ++j) {
+      if (regions[i].Intersects(regions[j])) {
+        return false;
+      }
+    }
+  }
+  caption_button_regions_ = regions;
+  return true;
+#else
+  return false;
+#endif
+}
+
+int CefWindowView::GetCaptionButtonComponent(const gfx::Point& point) const {
+#if BUILDFLAG(IS_WIN)
+  auto* widget = GetWidget();
+  if (is_frameless_ && widget && !widget->IsFullscreen()) {
+    if (caption_button_regions_[0].Contains(point)) {
+      return CanMinimize() ? HTMINBUTTON : HTCLIENT;
+    }
+    if (caption_button_regions_[1].Contains(point)) {
+      return CanMaximize() ? HTMAXBUTTON : HTCLIENT;
+    }
+    if (caption_button_regions_[2].Contains(point)) {
+      return HTCLOSE;
+    }
+  }
+#endif
+  return HTNOWHERE;
+}
